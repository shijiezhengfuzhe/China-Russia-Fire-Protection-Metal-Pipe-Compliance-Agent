# systemd 服务：CN-RU Fire Pipe Compliance API
# 放到 /etc/systemd/system/cnru-api.service
[Unit]
Description=CN-RU Fire Pipe Compliance API (FastAPI)
After=network.target

[Service]
Type=simple
# 改成你的实际项目目录
WorkingDirectory=/opt/cnru-fire-pipe
# 环境变量（也可用 EnvironmentFile=/opt/cnru-fire-pipe/.env 加载）
Environment=LLM_PROVIDER=mock
Environment=LLM_BASE_URL=https://api.deepseek.com/v1
Environment=LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
Environment=LLM_MODEL=deepseek-chat
Environment=WC_CORP_ID=wwxxxxxxxxxxxxxxxx
Environment=WC_AGENT_SECRET=xxxxxxxxxxxxxxxx
Environment=WC_AGENT_ID=1000002
ExecStart=/usr/bin/env python3 -m gunicorn -k uvicorn.workers.UvicornWorker \
    --bind 127.0.0.1:8000 --workers 2 --timeout 120 \
    --chdir /opt/cnru-fire-pipe engine.api_server:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
