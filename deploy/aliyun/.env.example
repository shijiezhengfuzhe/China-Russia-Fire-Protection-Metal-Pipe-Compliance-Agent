# 阿里云 ECS 部署 —— 环境变量模板
# 用法：cp 本文件为 .env，填好后；或用 systemd 的 Environment 加载。

# ---------- 服务 ----------
# 监听地址/端口（systemd 用 127.0.0.1:8000，由 Nginx 反代对外 443）
GUNICORN_BIND=127.0.0.1:8000
WORKERS=2

# ---------- LLM 报告层 (llm_report.py) ----------
# mock=不调用网络，用规则引擎结果生成模板报告；openai=调 OpenAI 兼容接口
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# ---------- 企业微信自建应用推送 (push_wechat.py) ----------
WC_CORP_ID=wwxxxxxxxxxxxxxxxx
WC_AGENT_SECRET=xxxxxxxxxxxxxxxx
WC_AGENT_ID=1000002
# 任意非空=强制 dry-run（只打印负载，不真实发送）；调试用
# WECHAT_DRY_RUN=1

# ---------- 知识库 / 数据 ----------
DATA_DIR=/opt/cnru-fire-pipe/data
